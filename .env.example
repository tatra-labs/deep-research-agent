# ---------------------------------------------------------------------------
# Required: one credential runs the whole pipeline.
# Used for both language-model inference and text embeddings.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Optional: model tiers. The defaults below are applied if these are unset.
#   WORKER  - high call volume: source reading, extraction, scouting
#   SYNTH   - low volume / high stakes: planning, fusion, writing, audit
# Provider prefix is required by the framework (e.g. "openai/...").
# ---------------------------------------------------------------------------
# DR_WORKER_MODEL=openai/gpt-4o-mini
# DR_SYNTH_MODEL=openai/gpt-4o
# DR_EMBED_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Optional: live web search. NONE of these are required.
# Without them the system falls back to keyless sources, and then to the
# committed response cache, so a fresh clone still produces a full report.
# ---------------------------------------------------------------------------
# SERPER_API_KEY=
# TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Optional: contact string sent in the User-Agent header. Wikipedia, the SEC
# and GDELT all require a descriptive agent with contact information; requests
# without one are refused. A sane default is used if unset.
# ---------------------------------------------------------------------------
# DR_CONTACT_EMAIL=you@example.com
